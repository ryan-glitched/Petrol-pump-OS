{
  "name": "petrol-pump-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:setup": "tsx prisma/setup.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.3",
    "lucide-react": "1.21.0",
    "next": "16.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.5",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
    "deepmerge-ts": "^8.0.0"
  }
}
