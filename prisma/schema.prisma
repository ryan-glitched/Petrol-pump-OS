// PetrolPumpOS V1 data model.
//
// Design rules:
// - PostgreSQL is the source of truth.
// - Money is stored as integer paisa; floating point money is never stored.
// - Operational rows are branch-scoped and linked with database foreign keys.
// - Business dates use validated YYYY-MM-DD strings in Asia/Karachi.
// - Fuel readings snapshot both price and dealer margin so history never changes.
// - Operational ledgers are append-only; corrections use adjustment/audit rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Tenant, identity, and access ----------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  timezone  String   @default("Asia/Karachi")
  currency  String   @default("PKR")
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           String // SuperAdmin | Owner | Manager | Cashier | Filler
  active         Boolean      @default(true)
  sessionVersion Int          @default(0)
  failedLogins   Int          @default(0)
  lockedUntil    DateTime?
  branches       UserBranch[]
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([active])
}

model UserBranch {
  userId     String
  branchId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

// ---- Station configuration ----------------------------------------------

model Branch {
  id                   String           @id @default(cuid())
  organizationId       String
  name                 String
  company              String
  city                 String
  managerName          String
  status               String           @default("SETUP") // LIVE | SETUP | INACTIVE
  timezone             String           @default("Asia/Karachi")
  varianceTolerancePct Float            @default(1.0)
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users                UserBranch[]
  tanks                Tank[]
  dispensers           Dispenser[]
  nozzles              Nozzle[]
  staff                Staff[]
  shifts               Shift[]
  readings             NozzleReading[]
  dips                 TankDip[]
  deliveries           Delivery[]
  salesEntries         SalesEntry[]
  mobilOilSales        MobilOilSale[]
  expenses             Expense[]
  creditCustomers      CreditCustomer[]
  creditSales          CreditSale[]
  creditPayments       CreditPayment[]
  fuelPrices           FuelPrice[]
  stockMoves           StockMove[]
  varianceLogs         VarianceLog[]
  auditLogs            AuditLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model Product {
  id          String          @id @default(cuid())
  name        String          @unique
  kind        String // FUEL | LUBE
  unit        String          @default("LITRE")
  active      Boolean         @default(true)
  tanks       Tank[]
  nozzles     Nozzle[]
  fuelPrices  FuelPrice[]
  deliveries  Delivery[]
  creditSales CreditSale[]
  readings    NozzleReading[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([kind, active])
}

model Tank {
  id           String        @id @default(cuid())
  branchId     String
  name         String
  productId    String
  capacityL    Float
  safeLevelL   Float
  active       Boolean       @default(true)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  nozzles      Nozzle[]
  dips         TankDip[]
  deliveries   Delivery[]
  stockMoves   StockMove[]
  varianceLogs VarianceLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([branchId, name])
  @@index([branchId, productId, active])
}

model Dispenser {
  id        String   @id @default(cuid())
  branchId  String
  label     String
  active    Boolean  @default(true)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  nozzles   Nozzle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, label])
  @@index([branchId, active])
}

model Nozzle {
  id          String          @id @default(cuid())
  branchId    String
  dispenserId String
  productId   String
  tankId      String
  label       String
  active      Boolean         @default(true)
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  dispenser   Dispenser       @relation(fields: [dispenserId], references: [id], onDelete: Restrict)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  tank        Tank            @relation(fields: [tankId], references: [id], onDelete: Restrict)
  readings    NozzleReading[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([dispenserId, label])
  @@index([branchId, active])
  @@index([tankId])
}

model Staff {
  id            String            @id @default(cuid())
  branchId      String
  employeeCode  String?
  name          String
  role          String // Manager | Cashier | Filler | Guard
  shiftSlot     String
  phone         String
  status        String // Present | Off Duty | Leave
  active        Boolean           @default(true)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  managedShifts Shift[]           @relation("ShiftManager")
  cashierShifts Shift[]           @relation("ShiftCashier")
  assignments   ShiftAssignment[]
  readings      NozzleReading[]
  mobilOilSales MobilOilSale[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([branchId, employeeCode])
  @@index([branchId, active, role])
}

// ---- Operational ledger --------------------------------------------------

model Shift {
  id               String            @id @default(cuid())
  branchId         String
  date             String
  shiftSlot        String
  status           String            @default("OPEN") // OPEN | CLOSED | APPROVED | VOID
  managerId        String?
  cashierId        String?
  fillers          String? // legacy display field; new records should use assignments
  guards           String? // legacy display field; new records should use assignments
  openingCashPaisa Int               @default(0)
  closingCashPaisa Int               @default(0)
  notes            String?
  closedAt         DateTime?
  approvedAt       DateTime?
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  manager          Staff?            @relation("ShiftManager", fields: [managerId], references: [id], onDelete: SetNull)
  cashier          Staff?            @relation("ShiftCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  assignments      ShiftAssignment[]
  readings         NozzleReading[]
  dips             TankDip[]
  sales            SalesEntry?
  creditSales      CreditSale[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([branchId, date, shiftSlot])
  @@index([branchId, date, status])
}

model ShiftAssignment {
  shiftId   String
  staffId   String
  duty      String // MANAGER | CASHIER | FILLER | GUARD
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([shiftId, staffId, duty])
  @@index([staffId])
}

model NozzleReading {
  id                    String    @id @default(cuid())
  branchId              String
  shiftId               String?
  nozzleId              String
  productId             String
  fuelPriceId           String
  opening               Float
  closing               Float
  litres                Float
  ratePaisa             Int
  dealerMarginPaisaPerL Int
  amountPaisa           Int
  staffId               String?
  date                  String
  branch                Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  nozzle                Nozzle    @relation(fields: [nozzleId], references: [id], onDelete: Restrict)
  product               Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fuelPrice             FuelPrice @relation(fields: [fuelPriceId], references: [id], onDelete: Restrict)
  staff                 Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  shift                 Shift?    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdAt             DateTime  @default(now())

  @@unique([shiftId, nozzleId])
  @@index([branchId, date])
  @@index([nozzleId, date])
  @@index([fuelPriceId])
}

model TankDip {
  id         String   @id @default(cuid())
  branchId   String
  shiftId    String?
  tankId     String
  date       String
  openingDip Float
  closingDip Float
  litres     Float
  notes      String?
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tank       Tank     @relation(fields: [tankId], references: [id], onDelete: Restrict)
  shift      Shift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([shiftId, tankId])
  @@index([branchId, tankId, date])
}

model Delivery {
  id        String   @id @default(cuid())
  branchId  String
  date      String
  supplier  String
  productId String
  tankId    String
  quantityL Float
  ratePaisa Int
  costPaisa Int
  invoice   String
  vehicle   String?
  notes     String?
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  tank      Tank     @relation(fields: [tankId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([branchId, invoice])
  @@index([branchId, date])
  @@index([tankId, date])
}

model SalesEntry {
  id              String   @id @default(cuid())
  branchId        String
  shiftId         String?  @unique
  date            String
  cashPaisa       Int
  cardPaisa       Int
  creditPaisa     Int
  totalPaisa      Int
  cashInHandPaisa Int
  diffPaisa       Int
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift           Shift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId, date])
}

model MobilOilSale {
  id            String   @id @default(cuid())
  branchId      String
  date          String
  productName   String
  qty           Int
  purchasePaisa Int
  sellingPaisa  Int
  profitPaisa   Int
  staffId       String?
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff         Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([branchId, date])
}

model Expense {
  id          String   @id @default(cuid())
  branchId    String
  date        String
  category    String
  amountPaisa Int
  paidBy      String
  description String
  receiptUrl  String?
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([branchId, date, category])
}

model CreditCustomer {
  id                  String          @id @default(cuid())
  branchId            String
  name                String
  company             String?
  phone               String?
  cnic                String?
  ntn                 String?
  address             String?
  creditLimitPaisa    Int?
  openingBalancePaisa Int             @default(0)
  openingPaidPaisa    Int             @default(0)
  openingDate         String?
  billingCycle        String          @default("MONTHLY") // FIFTEEN_DAYS | MONTHLY | CUSTOM
  billingDays         Int             @default(30)
  notes               String?
  active              Boolean         @default(true)
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vehicles            CreditVehicle[]
  sales               CreditSale[]
  payments            CreditPayment[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([branchId, active])
  @@index([branchId, name])
}

model CreditVehicle {
  id         String         @id @default(cuid())
  customerId String
  plate      String
  active     Boolean        @default(true)
  customer   CreditCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sales      CreditSale[]
  createdAt  DateTime       @default(now())

  @@unique([customerId, plate])
}

model CreditSale {
  id          String          @id @default(cuid())
  branchId    String
  shiftId     String?
  customerId  String
  vehicleId   String?
  productId   String
  date        String
  litres      Float
  amountPaisa Int
  paidPaisa   Int             @default(0)
  status      String // DUE | PARTIAL | PAID | VOID
  dueDate     String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift       Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  customer    CreditCustomer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle     CreditVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  payments    CreditPayment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([branchId, date])
  @@index([customerId, status, dueDate])
  @@index([vehicleId])
}

model CreditPayment {
  id           String         @id @default(cuid())
  branchId     String
  customerId   String
  creditSaleId String?
  date         String
  amountPaisa  Int
  method       String // CASH | CARD | BANK_TRANSFER | OTHER
  reference    String?
  notes        String?
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     CreditCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creditSale   CreditSale?    @relation(fields: [creditSaleId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@index([branchId, date])
  @@index([customerId, date])
  @@index([creditSaleId])
}

// ---- Pricing, inventory, and variance -----------------------------------

model FuelPrice {
  id                    String          @id @default(cuid())
  branchId              String
  productId             String
  ratePaisa             Int
  dealerMarginPaisaPerL Int
  purchaseCostPaisaPerL Int?
  effectiveFrom         String
  source                String          @default("MANUAL")
  notes                 String?
  branch                Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product               Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  readings              NozzleReading[]
  createdAt             DateTime        @default(now())

  @@unique([branchId, productId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@index([productId])
}

model StockMove {
  id        String   @id @default(cuid())
  branchId  String
  tankId    String
  type      String // OPENING | DELIVERY | SALE | ADJUSTMENT
  litres    Float // signed: positive in, negative out
  refId     String?
  reason    String?
  at        DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tank      Tank     @relation(fields: [tankId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([branchId, at])
  @@index([tankId, at])
  @@index([type, refId])
}

model VarianceLog {
  id          String   @id @default(cuid())
  branchId    String
  tankId      String
  date        String
  expectedL   Float
  actualL     Float
  varianceL   Float
  variancePct Float
  flagged     Boolean
  status      String   @default("OPEN") // OPEN | EXPLAINED | RESOLVED
  explanation String?
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tank        Tank     @relation(fields: [tankId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, tankId, date])
  @@index([branchId, date, flagged])
}

// ---- Audit ---------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  branchId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  at        DateTime @default(now())

  @@index([branchId, at])
  @@index([entity, entityId])
  @@index([userId, at])
}
